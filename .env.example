# WhatsApp number for order links: country code + number, digits only.
# Used as the default until it's changed from the editor toolbar.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999

# Password for the /admin site editor. Set a real one before launch.
ADMIN_PASSWORD=change-me

# Vercel Blob token. You do NOT set this by hand — creating a Blob store in the
# Vercel dashboard injects it automatically. For local editing, run
# `vercel env pull .env.local` to copy it down.
# BLOB_READ_WRITE_TOKEN=
